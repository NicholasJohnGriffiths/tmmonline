{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "Umbraco": {
    "CMS": {
      "Content": {
        "MacroErrors": "Throw"
      },
      "Hosting": {
        "Debug": true
      },
      "WebRouting": {
        "UmbracoApplicationUrl": "https://localhost:44366"
      }
    }
  },
  "LegacyMigration": {
    "Enabled": false,
    "RepairImagesOnStartup": false,
    "NormalizeImportedArticlesOnStartup": false,
    "HeaderBannerImagePath": "D:\\Clients\\Totora Publishing\\tmmbanner.jpg",
    "BaseUrl": "https://tmmonline.nz",
    "PagesCsvPath": "migration-output/pages.csv",
    "MaxArticles": 0,
    "OnlySectionSlug": "",
    "SectionSeeds": {
      "Video": "https://tmmonline.nz/video"
    }
  }
}
