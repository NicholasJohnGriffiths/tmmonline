@using TMMOnline.Web.Tagging
@using TMMOnline.Web.Rates
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@using System.Globalization
@using System.Net.Http
@using System.Net
@using System.Text
@using System.Text.RegularExpressions
@inherits UmbracoViewPage
@inject IMortgageRatesService MortgageRatesService
@{
    Layout = "_Layout.cshtml";
    var lead = Model.Value<string>("leadText");
    var sectionPriority = new[]
    {
        "people",
        "video",
        "podcast",
        "property-news",
        "news-bites",
        "rates",
        "conference",
        "news"
    };
    var sectionAliases = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["videos"] = "video",
        ["video"] = "video",
        ["podcasts"] = "podcast",
        ["podcast"] = "podcast",
        ["property"] = "property-news",
        ["propertynews"] = "property-news",
        ["property-news"] = "property-news",
        ["newsbites"] = "news-bites",
        ["news-bites"] = "news-bites",
        ["people"] = "people",
        ["rates"] = "rates",
        ["conference"] = "conference",
        ["news"] = "news"
    };
    var allArticles = Model.Root().DescendantsOfType("articlePage")
        .OrderByDescending(x => x.Value<DateTime?>("publishedOn") ?? DateTime.MinValue)
        .ThenByDescending(x => x.CreateDate)
        .ToArray();
    string currentSectionKey = ResolveSectionKey(Model);
    var sectionArticles = DeduplicateArticles(allArticles)
        .Where(article => string.Equals(ResolveOwnerSectionKey(article), currentSectionKey, StringComparison.OrdinalIgnoreCase))
        .ToArray();
    var sectionTags = ContentTagParser.ParseTags(Model.Value<string>("sectionTags"));
    var articles = sectionArticles.Length > 0
        ? sectionArticles
        : Array.Empty<IPublishedContent>();
    const int cardsPerRow = 3;
    const int rowsPerPage = 3;
    const int sectionPageSize = cardsPerRow * rowsPerPage;
    int currentPage = ParsePageNumber(Context.Request.Query["page"].FirstOrDefault());
    int totalPages = Math.Max(1, (int)Math.Ceiling(articles.Length / (double)sectionPageSize));
    currentPage = Math.Clamp(currentPage, 1, totalPages);
    var pagedArticles = articles
        .Skip((currentPage - 1) * sectionPageSize)
        .Take(sectionPageSize)
        .ToArray();
    var isConferenceSection = Model.Name.Contains("conference", StringComparison.OrdinalIgnoreCase)
        || sectionTags.Contains("conference", StringComparer.OrdinalIgnoreCase);
    var isRatesSection = Model.Name.Contains("rates", StringComparison.OrdinalIgnoreCase)
        || sectionTags.Contains("rates", StringComparer.OrdinalIgnoreCase);
    string mrtChange = Context.Request.Query["mrt_change"].FirstOrDefault() ?? "1week";
    string mrtChangeOnly = Context.Request.Query["mrt_change_only"].FirstOrDefault() ?? "0";
    string mrtType = Context.Request.Query["mrt_type"].FirstOrDefault() ?? "all";
    if (string.Equals(mrtType, "0", StringComparison.OrdinalIgnoreCase))
    {
        mrtType = "all";
    }

    string mrtTerm = Context.Request.Query["mrt_term"].FirstOrDefault() ?? "all";
    string mrtCol = Context.Request.Query["mrt_col"].FirstOrDefault() ?? "lender_name";
    string mrtDir = Context.Request.Query["mrt_dir"].FirstOrDefault() ?? "asc";
    string mrtOffset = Context.Request.Query["mrt_offset"].FirstOrDefault() ?? string.Empty;
    string mrtSpecial = Context.Request.Query["mrt_special"].FirstOrDefault() ?? string.Empty;
    string mrtValue = Context.Request.Query["mrt_value"].FirstOrDefault() ?? string.Empty;
    string mrtLoan = Context.Request.Query["mrt_loan"].FirstOrDefault() ?? string.Empty;
    int? requestedTermInMonths = MapLegacyTermToMonths(mrtTerm);
    var changedRateKeys = isRatesSection && string.Equals(mrtChangeOnly, "1", StringComparison.OrdinalIgnoreCase)
        ? await MortgageRatesService.GetChangedRateKeysAsync(mrtChange, requestedTermInMonths, Context.RequestAborted)
        : new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    var liveRates = isRatesSection
        ? ApplyLegacyRatesFilters(
            await MortgageRatesService.GetRatesAsync(150, requestedTermInMonths, Context.RequestAborted),
            mrtType,
            mrtTerm,
            mrtCol,
            mrtDir,
            mrtOffset,
            mrtSpecial,
            mrtChangeOnly,
            changedRateKeys)
        : Array.Empty<MortgageRateQuote>();
    if (isConferenceSection)
    {
        ViewData["HideFooter"] = true;
    }

    string ResolveContentUrl(IPublishedContent node)
    {
        string? url = node.Url();
        if (string.IsNullOrWhiteSpace(url) == false && url != "/")
        {
            return url;
        }

        return $"/?node={node.Id}";
    }

    string? GetPrimaryImageUrl(IPublishedContent article)
    {
        IPublishedContent? primaryImage = article.Value<IPublishedContent>("primaryImage");
        MediaWithCrops? imageWithCrops = article.Value<MediaWithCrops>("primaryImage");
        string? imageUrl = primaryImage?.Url() ?? imageWithCrops?.Url();
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return null;
        }

        return imageUrl.EndsWith(".gif", StringComparison.OrdinalIgnoreCase)
            ? null
            : imageUrl;
    }

    DateTime? NormalizeDisplayPublishedOn(DateTime? value)
    {
        if (value.HasValue == false)
        {
            return null;
        }

        return value.Value.Year <= 1900 ? null : value;
    }

    int? MapLegacyTermToMonths(string term)
    {
        return term switch
        {
            "rate_6month" => 6,
            "rate_1year" => 12,
            "rate_18month" => 18,
            "rate_2year" => 24,
            "rate_3year" => 36,
            "rate_4year" => 48,
            "rate_5year" => 60,
            _ => null
        };
    }

    bool MatchesLegacyTerm(MortgageRateQuote rate, string term)
    {
        string value = (rate.Term ?? string.Empty).Trim().ToLowerInvariant();

        return term switch
        {
            "all" => true,
            "rate_floating" => value.Contains("floating", StringComparison.OrdinalIgnoreCase)
                || value.Contains("variable", StringComparison.OrdinalIgnoreCase),
            "rate_rc" => value.Contains("rc", StringComparison.OrdinalIgnoreCase)
                || value.Contains("revolving", StringComparison.OrdinalIgnoreCase),
            _ => true
        };
    }

    bool IsMajorBank(string lender)
    {
        return lender.Contains("ANZ", StringComparison.OrdinalIgnoreCase)
            || lender.Contains("ASB", StringComparison.OrdinalIgnoreCase)
            || lender.Contains("BNZ", StringComparison.OrdinalIgnoreCase)
            || lender.Contains("Westpac", StringComparison.OrdinalIgnoreCase)
            || lender.Contains("Kiwibank", StringComparison.OrdinalIgnoreCase);
    }

    bool IsMinorBank(string lender)
    {
        return lender.Contains("SBS", StringComparison.OrdinalIgnoreCase)
            || lender.Contains("TSB", StringComparison.OrdinalIgnoreCase)
            || lender.Contains("Co-operative", StringComparison.OrdinalIgnoreCase)
            || lender.Contains("Heartland", StringComparison.OrdinalIgnoreCase);
    }

    IEnumerable<MortgageRateQuote> ApplyLegacyRatesFilters(
        IReadOnlyList<MortgageRateQuote> source,
        string lenderType,
        string term,
        string sortColumn,
        string sortDirection,
        string offset,
        string special,
        string changeOnly,
        IReadOnlySet<string> changedKeys)
    {
        IEnumerable<MortgageRateQuote> filtered = source;

        string BuildRateKey(MortgageRateQuote rate)
        {
            if (string.IsNullOrWhiteSpace(rate.RateId) == false)
            {
                return rate.RateId.Trim().ToLowerInvariant();
            }

            string lender = (rate.Lender ?? string.Empty).Trim().ToLowerInvariant();
            string product = (rate.Product ?? string.Empty).Trim().ToLowerInvariant();
            string rateTerm = (rate.Term ?? string.Empty).Trim().ToLowerInvariant();
            return $"{lender}|{product}|{rateTerm}";
        }

        if (MapLegacyTermToMonths(term).HasValue == false)
        {
            filtered = filtered.Where(rate => MatchesLegacyTerm(rate, term));
        }

        if (string.Equals(changeOnly, "1", StringComparison.OrdinalIgnoreCase) && changedKeys.Count > 0)
        {
            filtered = filtered.Where(rate => changedKeys.Contains(BuildRateKey(rate)));
        }

        filtered = lenderType switch
        {
            "major" => filtered.Where(rate => IsMajorBank(rate.Lender)),
            "minor" => filtered.Where(rate => IsMinorBank(rate.Lender)),
            "non-bank" => filtered.Where(rate => IsMajorBank(rate.Lender) == false && IsMinorBank(rate.Lender) == false),
            _ => filtered
        };

        if (string.Equals(offset, "1", StringComparison.OrdinalIgnoreCase))
        {
            filtered = filtered.Where(rate => rate.Product.Contains("offset", StringComparison.OrdinalIgnoreCase));
        }

        if (string.Equals(special, "1", StringComparison.OrdinalIgnoreCase))
        {
            filtered = filtered.Where(rate => rate.Product.Contains("special", StringComparison.OrdinalIgnoreCase));
        }

        bool descending = string.Equals(sortDirection, "desc", StringComparison.OrdinalIgnoreCase);
        if (string.Equals(sortColumn, "lender_name", StringComparison.OrdinalIgnoreCase))
        {
            filtered = descending
                ? filtered.OrderByDescending(rate => rate.Lender).ThenBy(rate => rate.Rate)
                : filtered.OrderBy(rate => rate.Lender).ThenBy(rate => rate.Rate);
        }
        else
        {
            filtered = descending
                ? filtered.OrderByDescending(rate => rate.Rate).ThenBy(rate => rate.Lender)
                : filtered.OrderBy(rate => rate.Rate).ThenBy(rate => rate.Lender);
        }

        return filtered.ToArray();
    }

    IEnumerable<IPublishedContent> DeduplicateArticles(IEnumerable<IPublishedContent> candidates)
    {
        var seenLegacy = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var seenTitleDate = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        string NormalizeLegacySource(string? raw)
        {
            if (string.IsNullOrWhiteSpace(raw))
            {
                return string.Empty;
            }

            string normalized = raw.Trim();
            int queryIndex = normalized.IndexOfAny(new[] { '?', '#' });
            if (queryIndex >= 0)
            {
                normalized = normalized[..queryIndex];
            }

            return normalized.TrimEnd('/').ToLowerInvariant();
        }

        string NormalizeTitleForDedup(string? raw)
        {
            string title = (raw ?? string.Empty).Trim();
            return Regex.Replace(title, "\\s*\\(\\d+\\)\\s*$", string.Empty).Trim().ToLowerInvariant();
        }

        foreach (IPublishedContent candidate in candidates)
        {
            string legacyKey = NormalizeLegacySource(candidate.Value<string>("legacySourceUrl"));
            string titleKey = $"{NormalizeTitleForDedup(candidate.Name)}|published:{(candidate.Value<DateTime?>("publishedOn") ?? DateTime.MinValue):yyyy-MM-dd}";

            bool isDuplicate =
                (string.IsNullOrWhiteSpace(legacyKey) == false && seenLegacy.Contains(legacyKey))
                || seenTitleDate.Contains(titleKey);

            if (isDuplicate)
            {
                continue;
            }

            if (string.IsNullOrWhiteSpace(legacyKey) == false)
            {
                seenLegacy.Add(legacyKey);
            }

            seenTitleDate.Add(titleKey);
            yield return candidate;
        }
    }

    string BuildArticleIdentityKey(IPublishedContent article)
    {
        string legacySource = article.Value<string>("legacySourceUrl")?.Trim() ?? string.Empty;
        string title = article.Name?.Trim() ?? string.Empty;
        DateTime publishedOn = article.Value<DateTime?>("publishedOn") ?? DateTime.MinValue;

        return string.IsNullOrWhiteSpace(legacySource) == false
            ? $"legacy:{legacySource.ToLowerInvariant()}"
            : $"title:{title.ToLowerInvariant()}|published:{publishedOn:O}";
    }

    string NormalizeSlug(string? raw)
    {
        string value = (raw ?? string.Empty).Trim().ToLowerInvariant();
        if (value.Length == 0)
        {
            return string.Empty;
        }

        value = Regex.Replace(value, "[^a-z0-9]+", "-");
        return Regex.Replace(value, "-+", "-").Trim('-');
    }

    string? MapToSectionKey(string? raw)
    {
        string normalized = NormalizeSlug(raw);
        if (normalized.Length == 0)
        {
            return null;
        }

        if (sectionAliases.TryGetValue(normalized, out string mapped))
        {
            return mapped;
        }

        return sectionPriority.Contains(normalized, StringComparer.OrdinalIgnoreCase)
            ? normalized
            : null;
    }

    string ResolveSectionKey(IPublishedContent sectionNode)
    {
        var candidates = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (string tag in ContentTagParser.ParseTags(sectionNode.Value<string>("sectionTags")))
        {
            string? mappedTag = MapToSectionKey(tag);
            if (mappedTag != null)
            {
                candidates.Add(mappedTag);
            }
        }

        string? mappedName = MapToSectionKey(sectionNode.Name);
        if (mappedName != null)
        {
            candidates.Add(mappedName);
        }

        string? mappedSlug = MapToSectionKey(sectionNode.UrlSegment);
        if (mappedSlug != null)
        {
            candidates.Add(mappedSlug);
        }

        foreach (string key in sectionPriority)
        {
            if (candidates.Contains(key))
            {
                return key;
            }
        }

        return mappedName ?? "news";
    }

    string ResolveOwnerSectionKey(IPublishedContent article)
    {
        var articleSectionCandidates = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (string tag in ContentTagParser.ParseTags(article.Value<string>("articleTags")))
        {
            string? mappedTag = MapToSectionKey(tag);
            if (mappedTag != null)
            {
                articleSectionCandidates.Add(mappedTag);
            }
        }

        string legacySource = article.Value<string>("legacySourceUrl")?.Trim() ?? string.Empty;
        bool hasExplicitVideoSource = legacySource.Contains("/video", StringComparison.OrdinalIgnoreCase);

        IPublishedContent? parentSection = article
            .AncestorsOrSelf()
            .FirstOrDefault(x => x.ContentType.Alias.Equals("sectionPage", StringComparison.OrdinalIgnoreCase));
        string? parentSectionKey = parentSection != null ? ResolveSectionKey(parentSection) : null;

        foreach (string key in sectionPriority)
        {
            if (key.Equals("video", StringComparison.OrdinalIgnoreCase)
                && hasExplicitVideoSource == false
                && string.Equals(parentSectionKey, "video", StringComparison.OrdinalIgnoreCase) == false)
            {
                continue;
            }

            if (articleSectionCandidates.Contains(key))
            {
                return key;
            }
        }

        return parentSectionKey != null
            ? parentSectionKey
            : "news";
    }

    int ParsePageNumber(string? rawPage)
    {
        return int.TryParse(rawPage, NumberStyles.Integer, CultureInfo.InvariantCulture, out int parsedPage) && parsedPage > 0
            ? parsedPage
            : 1;
    }

    IReadOnlyList<int?> BuildVisiblePageItems(int page, int pageCount)
    {
        if (pageCount <= 7)
        {
            return Enumerable.Range(1, pageCount).Select(x => (int?)x).ToArray();
        }

        var pages = new SortedSet<int>
        {
            1,
            pageCount,
            Math.Max(1, page - 1),
            page,
            Math.Min(pageCount, page + 1)
        };

        var items = new List<int?>();
        int previous = 0;
        foreach (int p in pages)
        {
            if (previous != 0 && p - previous > 1)
            {
                items.Add(null);
            }

            items.Add(p);
            previous = p;
        }

        return items;
    }

    string BuildPageUrl(int targetPage)
    {
        string path = Context.Request.Path.HasValue ? Context.Request.Path.Value! : "/";
        var queryParts = new List<string>();

        foreach (var pair in Context.Request.Query)
        {
            if (string.Equals(pair.Key, "page", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            string? value = pair.Value.FirstOrDefault();
            if (string.IsNullOrWhiteSpace(value))
            {
                continue;
            }

            queryParts.Add($"{Uri.EscapeDataString(pair.Key)}={Uri.EscapeDataString(value)}");
        }

        if (targetPage > 1)
        {
            queryParts.Add($"page={targetPage.ToString(CultureInfo.InvariantCulture)}");
        }

        return queryParts.Count > 0
            ? $"{path}?{string.Join("&", queryParts)}"
            : path;
    }

    string NormalizeConferenceProgrammeHtml(string? rawHtml)
    {
        if (string.IsNullOrWhiteSpace(rawHtml))
        {
            return string.Empty;
        }

        string html = rawHtml;
        Match programmeStart = Regex.Match(
            html,
            "(?<value><h1[^>]*>\\s*Better\\s+Business\\s+Programme\\s*</h1>.*)",
            RegexOptions.IgnoreCase | RegexOptions.Singleline);
        if (programmeStart.Success)
        {
            html = programmeStart.Groups["value"].Value;
        }

        MatchCollection tables = Regex.Matches(html, "<table\\b[^>]*>.*?</table>", RegexOptions.IgnoreCase | RegexOptions.Singleline);
        if (tables.Count > 1)
        {
            var seenTables = new HashSet<string>(StringComparer.Ordinal);
            var builder = new StringBuilder(html.Length);
            int cursor = 0;

            foreach (Match table in tables.Cast<Match>())
            {
                if (table.Index > cursor)
                {
                    builder.Append(html, cursor, table.Index - cursor);
                }

                string canonical = Regex.Replace(table.Value, "\\s+", " ").Trim();
                if (seenTables.Add(canonical))
                {
                    builder.Append(table.Value);
                }

                cursor = table.Index + table.Length;
            }

            if (cursor < html.Length)
            {
                builder.Append(html, cursor, html.Length - cursor);
            }

            html = builder.ToString();
        }

        html = Regex.Replace(
            html,
            "<h3[^>]*>\\s*(?:&nbsp;)?\\s*</h3>",
            string.Empty,
            RegexOptions.IgnoreCase | RegexOptions.Singleline);
        html = Regex.Replace(
            html,
            "<h3[^>]*>.*?update on speakers.*?details.*?here.*?</h3>",
            string.Empty,
            RegexOptions.IgnoreCase | RegexOptions.Singleline);
        html = Regex.Replace(
            html,
            "<p[^>]*>\\s*(?:&nbsp;)?\\s*</p>",
            string.Empty,
            RegexOptions.IgnoreCase | RegexOptions.Singleline);

        string[] footerMarkers =
        {
            "About Us",
            "Our Network",
            "TMM - The Mortgage Mag is 100% dedicated",
            "Tarawera Publishing Ltd"
        };

        int trimIndex = -1;
        foreach (string marker in footerMarkers)
        {
            int markerIndex = html.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
            if (markerIndex >= 0 && (trimIndex < 0 || markerIndex < trimIndex))
            {
                trimIndex = markerIndex;
            }
        }

        if (trimIndex >= 0)
        {
            int tagStart = html.LastIndexOf('<', trimIndex);
            html = (tagStart > 0 ? html[..tagStart] : html[..trimIndex]).Trim();
        }

        int sidebarCommentIndex = html.IndexOf("<!-- Sidebar -->", StringComparison.OrdinalIgnoreCase);
        if (sidebarCommentIndex >= 0)
        {
            html = html[..sidebarCommentIndex].Trim();
        }

        int sideRailIndex = html.IndexOf("side-rail", StringComparison.OrdinalIgnoreCase);
        if (sideRailIndex >= 0)
        {
            int tagStart = html.LastIndexOf('<', sideRailIndex);
            html = (tagStart > 0 ? html[..tagStart] : html[..sideRailIndex]).Trim();
        }

        html = Regex.Replace(html, "<footer\\b[^>]*>.*?</footer>", string.Empty, RegexOptions.IgnoreCase | RegexOptions.Singleline);
        html = BuildConferenceCalendarHtml(html);
        return html.Trim();
    }

    string? TryLoadLegacyConferenceHtml()
    {
        const string legacyConferenceUrl = "https://tmmonline.nz/better-business";

        try
        {
            using var handler = new HttpClientHandler();
            handler.ServerCertificateCustomValidationCallback = static (_, _, _, _) => true;
            using var httpClient = new HttpClient(handler);
            string html = httpClient.GetStringAsync(legacyConferenceUrl).GetAwaiter().GetResult();

            Match programmeStart = Regex.Match(
                html,
                "(?<value><h1[^>]*>\\s*Better\\s+Business\\s+Programme\\s*</h1>.*)",
                RegexOptions.IgnoreCase | RegexOptions.Singleline);
            if (programmeStart.Success)
            {
                html = programmeStart.Groups["value"].Value;
            }

            int trimIndex = html.IndexOf("About Us", StringComparison.OrdinalIgnoreCase);
            if (trimIndex >= 0)
            {
                int tagStart = html.LastIndexOf('<', trimIndex);
                html = (tagStart > 0 ? html[..tagStart] : html[..trimIndex]).Trim();
            }

            return html.Trim();
        }
        catch
        {
            return null;
        }
    }

    string BuildConferenceCalendarHtml(string html)
    {
        if (string.IsNullOrWhiteSpace(html))
        {
            return string.Empty;
        }

        string headingHtml = Regex.Match(html, "<h1[^>]*>.*?</h1>", RegexOptions.IgnoreCase | RegexOptions.Singleline).Value;
        string noteHtml = Regex.Match(
            html,
            "<p[^>]*>.*?update on speakers.*?</p>",
            RegexOptions.IgnoreCase | RegexOptions.Singleline).Value;

        var entries = new List<(string Time, string Title, string Speaker)>();

        MatchCollection rowMatches = Regex.Matches(html, "<tr\\b[^>]*>(?<row>.*?)</tr>", RegexOptions.IgnoreCase | RegexOptions.Singleline);
        foreach (Match rowMatch in rowMatches)
        {
            MatchCollection cellMatches = Regex.Matches(rowMatch.Groups["row"].Value, "<t[dh][^>]*>(?<cell>.*?)</t[dh]>", RegexOptions.IgnoreCase | RegexOptions.Singleline);
            var cells = cellMatches
                .Cast<Match>()
                .Select(x => Regex.Replace(WebUtility.HtmlDecode(x.Groups["cell"].Value), "<[^>]+>", string.Empty).Trim())
                .Where(x => string.IsNullOrWhiteSpace(x) == false && x != "\u00A0")
                .ToArray();

            if (cells.Length >= 2 && LooksLikeTime(cells[0]))
            {
                string speaker = cells.Length >= 3 ? cells[2] : string.Empty;
                entries.Add((cells[0], cells[1], speaker));
            }
        }

        if (entries.Count == 0)
        {
            MatchCollection headingMatches = Regex.Matches(html, "<h[3-5][^>]*>(?<value>.*?)</h[3-5]>", RegexOptions.IgnoreCase | RegexOptions.Singleline);
            var lines = headingMatches
                .Cast<Match>()
                .Select(x => Regex.Replace(WebUtility.HtmlDecode(x.Groups["value"].Value), "<[^>]+>", string.Empty).Trim())
                .Where(x => string.IsNullOrWhiteSpace(x) == false && x != "\u00A0")
                .ToList();

            for (int i = 0; i < lines.Count; i++)
            {
                if (LooksLikeTime(lines[i]) == false)
                {
                    continue;
                }

                string time = lines[i];
                string title = i + 1 < lines.Count ? lines[i + 1] : string.Empty;
                string speaker = i + 2 < lines.Count && LooksLikeTime(lines[i + 2]) == false ? lines[i + 2] : string.Empty;

                if (string.IsNullOrWhiteSpace(title) == false && LooksLikeTime(title) == false)
                {
                    entries.Add((time, title, speaker));
                }
            }
        }

        if (entries.Count == 0)
        {
            return html;
        }

        var builder = new StringBuilder();
        if (string.IsNullOrWhiteSpace(headingHtml) == false)
        {
            builder.Append(headingHtml);
        }

        builder.Append("<div class=\"conference-calendar\">");
        foreach ((string time, string title, string speaker) in entries)
        {
            builder.Append("<article class=\"conference-calendar-item\">");
            builder.Append("<div class=\"conference-calendar-time\">")
                .Append(WebUtility.HtmlEncode(time))
                .Append("</div>");
            builder.Append("<div class=\"conference-calendar-content\">");
            builder.Append("<h3>")
                .Append(WebUtility.HtmlEncode(title))
                .Append("</h3>");
            if (string.IsNullOrWhiteSpace(speaker) == false)
            {
                builder.Append("<p class=\"conference-calendar-speaker\">")
                    .Append(WebUtility.HtmlEncode(speaker))
                    .Append("</p>");
            }
            builder.Append("</div></article>");
        }
        builder.Append("</div>");

        if (string.IsNullOrWhiteSpace(noteHtml) == false)
        {
            builder.Append(noteHtml);
        }

        return builder.ToString();
    }

    bool LooksLikeTime(string value)
    {
        return Regex.IsMatch(
            value,
            "\\b\\d{1,2}(?::\\d{2})?\\s*(?:am|pm)\\b|\\b\\d{1,2}(?::\\d{2})?\\s*(?:am|pm)\\s*-\\s*\\d{1,2}(?::\\d{2})?\\s*(?:am|pm)\\b",
            RegexOptions.IgnoreCase);
    }
}

@await Html.PartialAsync("Partials/Site/TopAdvert", Model)

<article class="content-page">
    <header>
        <h1>@Model.Name</h1>
        @if (!string.IsNullOrWhiteSpace(lead))
        {
            <p class="lead">@lead</p>
        }
    </header>

    @if (isRatesSection == false)
    {
        @await Html.PartialAsync("Partials/Site/ContentBlocks", Model)
    }

    @if (isConferenceSection)
    {
        IPublishedContent? conferenceArticle = articles.FirstOrDefault();
        string? conferenceSourceHtml = conferenceArticle?.Value<string>("bodyText");
        if (string.IsNullOrWhiteSpace(conferenceSourceHtml))
        {
            conferenceSourceHtml = Model.Value<string>("bodyText");
        }

        if (string.IsNullOrWhiteSpace(conferenceSourceHtml))
        {
            conferenceSourceHtml = TryLoadLegacyConferenceHtml();
        }

        string conferenceProgrammeHtml = NormalizeConferenceProgrammeHtml(conferenceSourceHtml);

        <section class="conference-programme" aria-label="Better Business Programme">
            @if (string.IsNullOrWhiteSpace(conferenceProgrammeHtml) == false)
            {
                @Html.Raw(conferenceProgrammeHtml)
            }
            else
            {
                <p class="meta">Better Business Programme content is being prepared.</p>
            }
        </section>
    }
    else if (isRatesSection)
    {
        <section class="rates-live" aria-label="Latest mortgage rates">
            <h2>Latest Mortgage Rates</h2>
            <form class="rates-filters" method="get" action="@Context.Request.Path">
                <p>
                    <label for="mrt-change">Changes from last:</label>
                    <select id="mrt-change" name="mrt_change" onchange="this.form.submit()">
                        <option value="1day" selected="@(mrtChange == "1day" ? "selected" : null)">One day</option>
                        <option value="1week" selected="@(mrtChange == "1week" ? "selected" : null)">One week</option>
                        <option value="2week" selected="@(mrtChange == "2week" ? "selected" : null)">Two weeks</option>
                        <option value="4week" selected="@(mrtChange == "4week" ? "selected" : null)">Four weeks</option>
                        <option value="3month" selected="@(mrtChange == "3month" ? "selected" : null)">Three months</option>
                        <option value="6month" selected="@(mrtChange == "6month" ? "selected" : null)">Six months</option>
                    </select>
                </p>
                <p>
                    <label for="mrt-change-only">Rate movement:</label>
                    <select id="mrt-change-only" name="mrt_change_only" onchange="this.form.submit()">
                        <option value="0" selected="@(mrtChangeOnly == "0" ? "selected" : null)">Show all rates</option>
                        <option value="1" selected="@(mrtChangeOnly == "1" ? "selected" : null)">Changes only</option>
                    </select>
                </p>
                <p>
                    <label for="mrt-type">Lender type:</label>
                    <select id="mrt-type" name="mrt_type" onchange="this.form.submit()">
                        <option value="all" selected="@(mrtType == "all" ? "selected" : null)">All lenders</option>
                        <option value="major" selected="@(mrtType == "major" ? "selected" : null)">Major banks</option>
                        <option value="minor" selected="@(mrtType == "minor" ? "selected" : null)">Minor banks</option>
                        <option value="non-bank" selected="@(mrtType == "non-bank" ? "selected" : null)">Non-bank lenders</option>
                    </select>
                </p>
                <p>
                    <label for="mrt-term">Term:</label>
                    <select id="mrt-term" name="mrt_term" onchange="this.form.submit()">
                        <option value="all" selected="@(mrtTerm == "all" ? "selected" : null)">all</option>
                        <option value="rate_floating" selected="@(mrtTerm == "rate_floating" ? "selected" : null)">Floating</option>
                        <option value="rate_6month" selected="@(mrtTerm == "rate_6month" ? "selected" : null)">6 mth</option>
                        <option value="rate_1year" selected="@(mrtTerm == "rate_1year" ? "selected" : null)">1 year</option>
                        <option value="rate_18month" selected="@(mrtTerm == "rate_18month" ? "selected" : null)">18 mth</option>
                        <option value="rate_2year" selected="@(mrtTerm == "rate_2year" ? "selected" : null)">2 years</option>
                        <option value="rate_3year" selected="@(mrtTerm == "rate_3year" ? "selected" : null)">3 years</option>
                        <option value="rate_4year" selected="@(mrtTerm == "rate_4year" ? "selected" : null)">4 years</option>
                        <option value="rate_5year" selected="@(mrtTerm == "rate_5year" ? "selected" : null)">5 years</option>
                        <option value="rate_rc" selected="@(mrtTerm == "rate_rc" ? "selected" : null)">RC</option>
                    </select>
                </p>
                <p>
                    <label for="mrt-value">Property value:</label>
                    <input id="mrt-value" type="text" name="mrt_value" value="@mrtValue" />
                </p>
                <p>
                    <label for="mrt-loan">Loan amount:</label>
                    <input id="mrt-loan" type="text" name="mrt_loan" value="@mrtLoan" />
                </p>
                <p>
                    <label><input type="checkbox" name="mrt_offset" value="1" checked="@(mrtOffset == "1" ? "checked" : null)" /> Offset only</label>
                    <label><input type="checkbox" name="mrt_special" value="1" checked="@(mrtSpecial == "1" ? "checked" : null)" /> Special only</label>
                </p>
                <input type="hidden" name="mrt_col" value="@mrtCol" />
                <input type="hidden" name="mrt_dir" value="@mrtDir" />
                <p>
                    <button type="submit">Go</button>
                    <a href="@Context.Request.Path">Reset</a>
                </p>
            </form>

            @if (liveRates.Count > 0)
            {
                <div class="rates-live-table" role="region" aria-label="Live mortgage rates">
                    <table class="rates-table">
                        <thead>
                            <tr>
                                <th scope="col">
                                    Lender
                                    <a href="@($"{Context.Request.Path}?mrt_change={mrtChange}&mrt_change_only={mrtChangeOnly}&mrt_type={mrtType}&mrt_term={mrtTerm}&mrt_offset={mrtOffset}&mrt_special={mrtSpecial}&mrt_value={mrtValue}&mrt_loan={mrtLoan}&mrt_col=lender_name&mrt_dir=asc")">▲</a>
                                    <a href="@($"{Context.Request.Path}?mrt_change={mrtChange}&mrt_change_only={mrtChangeOnly}&mrt_type={mrtType}&mrt_term={mrtTerm}&mrt_offset={mrtOffset}&mrt_special={mrtSpecial}&mrt_value={mrtValue}&mrt_loan={mrtLoan}&mrt_col=lender_name&mrt_dir=desc")">▼</a>
                                </th>
                                <th scope="col">Product</th>
                                <th scope="col">Term</th>
                                <th scope="col">
                                    Rate
                                    <a href="@($"{Context.Request.Path}?mrt_change={mrtChange}&mrt_change_only={mrtChangeOnly}&mrt_type={mrtType}&mrt_term={mrtTerm}&mrt_offset={mrtOffset}&mrt_special={mrtSpecial}&mrt_value={mrtValue}&mrt_loan={mrtLoan}&mrt_col=rate&mrt_dir=asc")">▲</a>
                                    <a href="@($"{Context.Request.Path}?mrt_change={mrtChange}&mrt_change_only={mrtChangeOnly}&mrt_type={mrtType}&mrt_term={mrtTerm}&mrt_offset={mrtOffset}&mrt_special={mrtSpecial}&mrt_value={mrtValue}&mrt_loan={mrtLoan}&mrt_col=rate&mrt_dir=desc")">▼</a>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rate in liveRates)
                            {
                                <tr>
                                    <th scope="row">@rate.Lender</th>
                                    <td>@(string.IsNullOrWhiteSpace(rate.Product) ? "-" : rate.Product)</td>
                                    <td>@(string.IsNullOrWhiteSpace(rate.Term) ? "-" : rate.Term)</td>
                                    <td>@($"{rate.Rate:0.00}%")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                var asAt = liveRates
                    .Select(x => x.UpdatedAt)
                    .Where(x => x.HasValue)
                    .Select(x => x!.Value)
                    .OrderByDescending(x => x)
                    .FirstOrDefault();

                if (asAt != default)
                {
                    <p class="meta">Updated @asAt.ToLocalTime().ToString("dd MMM yyyy h:mm tt")</p>
                }
            }
            else
            {
                <p class="meta">Live rates are temporarily unavailable. Please check back shortly.</p>
                <p class="meta">You can still view the legacy table at <a href="https://tmmonline.nz/rates" target="_blank" rel="noopener noreferrer">tmmonline.nz/rates</a>.</p>
            }
        </section>
    }
    else if (articles.Length > 0)
    {
        <section class="section-articles">
            <div class="section-card-grid section-card-grid-three">
                @for (int i = 0; i < pagedArticles.Length; i++)
                {
                    var article = pagedArticles[i];
                    var articlePublishedOn = NormalizeDisplayPublishedOn(article.Value<DateTime?>("publishedOn"));
                    var articleTags = ContentTagParser.ParseTags(article.Value<string>("articleTags"));
                    var articleLead = article.Value<string>("leadText") ?? article.Value<string>("introText") ?? "Read the full story.";
                    var articleImageUrl = GetPrimaryImageUrl(article);
                    var articleHref = ResolveContentUrl(article);

                    <article class="section-article-card">
                        <a class="section-article-link" href="@articleHref">
                            @if (string.IsNullOrWhiteSpace(articleImageUrl) == false)
                            {
                                <img src="@articleImageUrl" alt="@article.Name" loading="lazy" />
                            }
                            else
                            {
                                <div class="section-article-placeholder" aria-hidden="true">No Image</div>
                            }
                        </a>

                        <div class="section-article-content">
                            <h3><a href="@articleHref">@article.Name</a></h3>
                            @if (!string.IsNullOrWhiteSpace(articleLead))
                            {
                                <p class="section-article-excerpt">@articleLead</p>
                            }
                            <p class="meta">
                        @if (articlePublishedOn.HasValue)
                        {
                                <span class="meta-date">@articlePublishedOn.Value.ToString("dd MMM yyyy")</span>
                        }
                        @if (articleTags.Count > 0)
                        {
                                <span class="meta-tags">@string.Join(", ", articleTags)</span>
                        }
                            </p>
                        </div>
                    </article>
                }
            </div>

            @if (totalPages > 1)
            {
                <nav class="section-pagination" aria-label="Section pages">
                    @if (currentPage > 1)
                    {
                        <a class="section-pagination-link section-pagination-link-nav" href="@BuildPageUrl(currentPage - 1)" rel="prev" aria-label="Go to previous page">Previous</a>
                    }
                    else
                    {
                        <span class="section-pagination-link section-pagination-link-nav is-disabled" aria-disabled="true">Previous</span>
                    }

                    <ol class="section-pagination-pages">
                        @foreach (int? pageItem in BuildVisiblePageItems(currentPage, totalPages))
                        {
                            if (pageItem.HasValue)
                            {
                                int pageNumber = pageItem.Value;
                                bool isCurrentPage = pageNumber == currentPage;
                                <li>
                                    @if (isCurrentPage)
                                    {
                                        <span class="section-pagination-link section-pagination-link-number is-current" aria-current="page">@(pageNumber)</span>
                                    }
                                    else
                                    {
                                        <a class="section-pagination-link section-pagination-link-number" href="@BuildPageUrl(pageNumber)" aria-label="Go to page @(pageNumber)">@(pageNumber)</a>
                                    }
                                </li>
                            }
                            else
                            {
                                <li><span class="section-pagination-ellipsis" aria-hidden="true">...</span></li>
                            }
                        }
                    </ol>

                    <span class="section-pagination-status">Page @currentPage of @totalPages</span>

                    @if (currentPage < totalPages)
                    {
                        <a class="section-pagination-link section-pagination-link-nav" href="@BuildPageUrl(currentPage + 1)" rel="next" aria-label="Go to next page">Next</a>
                    }
                    else
                    {
                        <span class="section-pagination-link section-pagination-link-nav is-disabled" aria-disabled="true">Next</span>
                    }
                </nav>
            }
        </section>
    }
    else
    {
        <section class="section-articles">
            <p class="meta">No articles were found under this section yet.</p>
        </section>
    }
</article>