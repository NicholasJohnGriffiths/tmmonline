        }

        @if (string.IsNullOrWhiteSpace(bodyHtml) == false)
        {
            <section class="rich-text">
                @Html.Raw(bodyHtml)
            </section>
        }

        @if (selectedNode.HasValue("contentBlocks"))
        {
            @await Html.GetBlockListHtmlAsync(selectedNode, "contentBlocks")
        }
    </article>
}
else
{
<div class="homepage-shell">
    <div class="homepage-main-column">
        <section class="homepage-hero">
            <div class="hero-intro">
                <span class="eyebrow">Legacy-inspired newsroom</span>
                <h1>@heading</h1>
                <p>@intro</p>
            </div>

            @if (featuredArticle != null)
            {
                var featuredDate = NormalizeDisplayPublishedOn(featuredArticle.Value<DateTime?>("publishedOn"));
                var featuredLead = featuredArticle.Value<string>("leadText") ?? featuredArticle.Value<string>("introText");
                var featuredImageUrl = GetPrimaryImageUrl(featuredArticle);

                <article class="featured-story">
                    @if (string.IsNullOrWhiteSpace(featuredImageUrl) == false)
