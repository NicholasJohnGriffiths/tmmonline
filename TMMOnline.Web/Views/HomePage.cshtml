                    <a href="https://tmmonline.nz/rates?mrt_col=rate_rc&amp;mrt_dir=asc&amp;mrt_term=rate_rc" target="_blank" rel="noopener noreferrer">Revolving Credit</a>
                    <a href="https://tmmonline.nz/rates?mrt_offset=1" target="_blank" rel="noopener noreferrer">Offset Mortgages</a>
                    <a href="https://tmmonline.nz/rates?mrt_special=1" target="_blank" rel="noopener noreferrer">Special Rates</a>
                </div>
                <div class="rates-live-embed">
                    <iframe
                        src="https://tmmonline.nz/rates"
                        title="Latest Mortgage Rates"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
                <p class="meta">If the live table does not load in your browser, open <a href="https://tmmonline.nz/rates" target="_blank" rel="noopener noreferrer">tmmonline.nz/rates</a>.</p>
            </section>
        }
        else if (sectionArticles.Count > 0)
        {
            <section class="section-articles">
                <div class="section-card-grid section-card-grid-three">
                    @for (int i = 0; i < pagedArticles.Length; i++)
                    {
                        var article = pagedArticles[i];
                        var articlePublishedOn = NormalizeDisplayPublishedOn(article.Value<DateTime?>("publishedOn"));
                        var articleTags = ContentTagParser.ParseTags(article.Value<string>("articleTags"));
                        var articleLead = article.Value<string>("leadText") ?? article.Value<string>("introText") ?? "Read the full story.";
                        var articleImageUrl = GetPrimaryImageUrl(article);
                        var articleHref = ResolveContentUrl(article);

                        <article class="section-article-card">
                            @if (string.IsNullOrWhiteSpace(articleImageUrl) == false)
                            {
                                <a class="section-article-link" href="@articleHref">
                                    <img src="@articleImageUrl" alt="@article.Name" loading="lazy" />
                                </a>
                            }

                            <div class="section-article-content">
                                <h3><a href="@articleHref">@article.Name</a></h3>
                                @if (!string.IsNullOrWhiteSpace(articleLead))
                                {
                                    <p class="section-article-excerpt">@articleLead</p>
                                }
                                <p class="meta">
                            @if (articlePublishedOn.HasValue)
                            {
                                    <span class="meta-date">@articlePublishedOn.Value.ToString("dd MMM yyyy")</span>
                            }
                            @if (articleTags.Count > 0)
                            {
                                    <span class="meta-tags">@string.Join(", ", articleTags)</span>
                            }
                                </p>
                            </div>
                        </article>
                    }
                </div>

                @if (totalPages > 1)
                    {
                    <nav class="section-pagination" aria-label="Section pages">
                        @if (currentPage > 1)
                        {
                            <a class="section-pagination-link section-pagination-link-nav" href="@BuildPageUrl(currentPage - 1)" rel="prev" aria-label="Go to previous page">Previous</a>
                        }
                        else
                        {
                            <span class="section-pagination-link section-pagination-link-nav is-disabled" aria-disabled="true">Previous</span>
                        }

                        <ol class="section-pagination-pages">
                            @foreach (int? pageItem in BuildVisiblePageItems(currentPage, totalPages))
                            {
                                if (pageItem.HasValue)
                                {
                                    int pageNumber = pageItem.Value;
                                    bool isCurrentPage = pageNumber == currentPage;
                                    <li>
                                        @if (isCurrentPage)
                                        {
                                            <span class="section-pagination-link section-pagination-link-number is-current" aria-current="page">@(pageNumber)</span>
                                        }
                                        else
                                        {
                                            <a class="section-pagination-link section-pagination-link-number" href="@BuildPageUrl(pageNumber)" aria-label="Go to page @(pageNumber)">@(pageNumber)</a>
                                        }
                                    </li>
                                }
                                else
                                {
                                    <li><span class="section-pagination-ellipsis" aria-hidden="true">...</span></li>
                                }
                            }
                        </ol>

                        <span class="section-pagination-status">Page @currentPage of @totalPages</span>

                        @if (currentPage < totalPages)
                        {
                            <a class="section-pagination-link section-pagination-link-nav" href="@BuildPageUrl(currentPage + 1)" rel="next" aria-label="Go to next page">Next</a>
                        }
                        else
                        {
                            <span class="section-pagination-link section-pagination-link-nav is-disabled" aria-disabled="true">Next</span>
                        }
                    </nav>
                }
            </section>
        }
        else
        {
            <section class="section-articles">
                <p class="meta">No articles were found under this section yet.</p>
            </section>
        }
    </article>
}
else if (selectedNode?.ContentType.Alias.Equals("articlePage", StringComparison.OrdinalIgnoreCase) == true)
{
    var publishedOn = NormalizeDisplayPublishedOn(selectedNode.Value<DateTime?>("publishedOn"));
    string articleUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    string encodedArticleUrl = Uri.EscapeDataString(articleUrl);
    string encodedArticleTitle = Uri.EscapeDataString(selectedNode.Name ?? "");
    string instagramShareUrl = $"https://www.instagram.com/?url={encodedArticleUrl}";
    string facebookShareUrl = $"https://www.facebook.com/sharer/sharer.php?u={encodedArticleUrl}";
    string xShareUrl = $"https://twitter.com/intent/tweet?url={encodedArticleUrl}&text={encodedArticleTitle}";
    string currentArticleSectionKey = ResolveOwnerSectionKey(selectedNode);
    var readNextArticles = dedupedArticles
        .Where(article => article.Id != selectedNode.Id)
        .Where(article => string.Equals(ResolveOwnerSectionKey(article), currentArticleSectionKey, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(article => article.Value<DateTime?>("publishedOn") ?? DateTime.MinValue)
        .ThenByDescending(article => article.CreateDate)
        .Take(3)
        .ToArray();
    var articleTags = ContentTagParser.ParseTags(selectedNode.Value<string>("articleTags"));
    IPublishedContent? primaryImage = selectedNode.Value<IPublishedContent>("primaryImage");
    MediaWithCrops? imageWithCrops = selectedNode.Value<MediaWithCrops>("primaryImage");
    string? primaryImageUrl = primaryImage?.Url() ?? imageWithCrops?.Url();
    int? primaryImageWidth = primaryImage?.Value<int?>("umbracoWidth");
    int? primaryImageHeight = primaryImage?.Value<int?>("umbracoHeight");
    if (string.IsNullOrWhiteSpace(primaryImageUrl) == false
        && primaryImageUrl.EndsWith(".gif", StringComparison.OrdinalIgnoreCase))
    {
        primaryImageUrl = null;
    }
    if (primaryImageWidth.HasValue && primaryImageHeight.HasValue
        && (primaryImageWidth.Value < 300 || primaryImageHeight.Value < 150))
    {
        primaryImageUrl = null;
    }

    bool isVideoArticle = articleTags.Contains("video", StringComparer.OrdinalIgnoreCase);
    if (isVideoArticle)
    {
        primaryImageUrl = null;
    }
    string primaryImageAlt = primaryImage?.Name ?? selectedNode.Name;
    string rawBodyHtml = selectedNode.Value<string>("bodyText") ?? string.Empty;
    string bodyHtml = RemoveLeadingDuplicateHero(rawBodyHtml, primaryImageUrl, selectedNode.Name);

    <article class="article-page">
        <header>
            <h1>@selectedNode.Name</h1>
            @if (publishedOn.HasValue)
            {
                <p class="meta">Published @publishedOn.Value.ToString("dd MMM yyyy")</p>
            }
        </header>

        @if (string.IsNullOrWhiteSpace(primaryImageUrl) == false)
        {
            <figure class="article-primary-image">
                <img src="@primaryImageUrl" alt="@primaryImageAlt" loading="lazy" />
            </figure>
        }

        @if (string.IsNullOrWhiteSpace(bodyHtml) == false)
        {
            <section class="rich-text">
                @Html.Raw(bodyHtml)
            </section>
        }

        <section class="article-social-share" aria-label="Share this article">
            <p class="article-social-label">Share this article</p>
            <div class="article-social-links">
                <a class="article-social-link article-social-link-instagram" href="@instagramShareUrl" target="_blank" rel="noopener noreferrer" aria-label="Share on Instagram">IG</a>
                <a class="article-social-link article-social-link-facebook" href="@facebookShareUrl" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook">f</a>
                <a class="article-social-link article-social-link-x" href="@xShareUrl" target="_blank" rel="noopener noreferrer" aria-label="Share on X (Twitter)">X</a>
            </div>
        </section>

        @if (selectedNode.HasValue("contentBlocks"))
        {
            @await Html.GetBlockListHtmlAsync(selectedNode, "contentBlocks")
        }

        @if (readNextArticles.Length > 0)
        {
            <section class="article-read-next" aria-label="Read this next">
                <h2>Read this next</h2>
                <div class="section-card-grid section-card-grid-three">
                    @foreach (var article in readNextArticles)
                    {
                        var nextArticleDate = NormalizeDisplayPublishedOn(article.Value<DateTime?>("publishedOn"));
                        var nextArticleImageUrl = GetPrimaryImageUrl(article);
                        var nextArticleLead = article.Value<string>("leadText") ?? article.Value<string>("introText") ?? "Read the full story.";
                        var nextArticleHref = ResolveContentUrl(article);

                        <article class="section-article-card">
                            <a class="section-article-link" href="@nextArticleHref">
                                @if (string.IsNullOrWhiteSpace(nextArticleImageUrl) == false)
                                {
                                    <img src="@nextArticleImageUrl" alt="@article.Name" loading="lazy" />
                                }
                            </a>

                            <div class="section-article-content">
                                <h3><a href="@nextArticleHref">@article.Name</a></h3>
                                @if (!string.IsNullOrWhiteSpace(nextArticleLead))
                                {
                                    <p class="section-article-excerpt">@nextArticleLead</p>
                                }
                                @if (nextArticleDate.HasValue)
                                {
                                    <p class="meta"><span class="meta-date">@nextArticleDate.Value.ToString("dd MMM yyyy")</span></p>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    </article>
}
else if (isSearchRoute)
{
    string searchTerm = (Context.Request.Query["q"].FirstOrDefault() ?? string.Empty).Trim();
    int searchPage = ParsePageNumber(Context.Request.Query["page"].FirstOrDefault());
    const int resultsPerPage = 9;

    var matchingArticles = string.IsNullOrWhiteSpace(searchTerm)
        ? Array.Empty<IPublishedContent>()
        : dedupedArticles
            .Where(article => ArticleMatchesSearch(article, searchTerm))
            .OrderByDescending(article => article.Value<DateTime?>("publishedOn") ?? DateTime.MinValue)
            .ThenByDescending(article => article.CreateDate)
            .ToArray();

    int totalPages = Math.Max(1, (int)Math.Ceiling(matchingArticles.Length / (double)resultsPerPage));
    searchPage = Math.Clamp(searchPage, 1, totalPages);
    var pagedResults = matchingArticles
        .Skip((searchPage - 1) * resultsPerPage)
        .Take(resultsPerPage)
        .ToArray();

    <section class="content-page search-results-page">
        <header>
            <h1>Search Results</h1>
            <p class="lead">Search all published articles by title, body text and tags.</p>
        </header>

        <form class="search-form" method="get" action="/search">
            <label class="sr-only" for="search-q">Search articles</label>
            <input id="search-q" name="q" type="search" value="@searchTerm" placeholder="Search articles" />
            <button type="submit">Search</button>
        </form>

        @if (string.IsNullOrWhiteSpace(searchTerm))
        {
            <p class="meta">Enter a search term to find articles.</p>
        }
        else
        {
            <p class="meta">@matchingArticles.Length result@(matchingArticles.Length == 1 ? string.Empty : "s") found for "@searchTerm".</p>

            @if (pagedResults.Length > 0)
            {
                <section class="section-articles search-results-articles">
                    <div class="section-card-grid section-card-grid-three">
                        @foreach (var article in pagedResults)
                        {
                            var articlePublishedOn = NormalizeDisplayPublishedOn(article.Value<DateTime?>("publishedOn"));
                            var articleTags = ContentTagParser.ParseTags(article.Value<string>("articleTags"));
                            var articleLead = article.Value<string>("leadText") ?? article.Value<string>("introText") ?? "Read the full story.";
                            var articleImageUrl = GetPrimaryImageUrl(article);
                            var articleHref = ResolveContentUrl(article);

                            <article class="section-article-card">
                                @if (string.IsNullOrWhiteSpace(articleImageUrl) == false)
                                {
                                    <a class="section-article-link" href="@articleHref">
                                        <img src="@articleImageUrl" alt="@article.Name" loading="lazy" />
                                    </a>
                                }

                                <div class="section-article-content">
                                    <h3><a href="@articleHref">@article.Name</a></h3>
                                    @if (!string.IsNullOrWhiteSpace(articleLead))
                                    {
                                        <p class="section-article-excerpt">@articleLead</p>
                                    }
                                    <p class="meta">
                                        @if (articlePublishedOn.HasValue)
                                        {
                                            <span class="meta-date">@articlePublishedOn.Value.ToString("dd MMM yyyy")</span>
                                        }
                                        @if (articleTags.Count > 0)
                                        {
                                            <span class="meta-tags">@string.Join(", ", articleTags)</span>
                                        }
                                    </p>
                                </div>
                            </article>
                        }
                    </div>

                    @if (totalPages > 1)
                    {
                        <nav class="section-pagination" aria-label="Search results pages">
                            @if (searchPage > 1)
                            {
                                <a class="section-pagination-link section-pagination-link-nav" href="@BuildPageUrl(searchPage - 1)" rel="prev" aria-label="Go to previous page">Previous</a>
                            }
                            else
                            {
                                <span class="section-pagination-link section-pagination-link-nav is-disabled" aria-disabled="true">Previous</span>
                            }

                            <ol class="section-pagination-pages">
                                @foreach (int? pageItem in BuildVisiblePageItems(searchPage, totalPages))
                                {
                                    if (pageItem.HasValue)
                                    {
                                        int pageNumber = pageItem.Value;
                                        bool isCurrentPage = pageNumber == searchPage;
                                        <li>
                                            @if (isCurrentPage)
                                            {
                                                <span class="section-pagination-link section-pagination-link-number is-current" aria-current="page">@(pageNumber)</span>
                                            }
                                            else
                                            {
                                                <a class="section-pagination-link section-pagination-link-number" href="@BuildPageUrl(pageNumber)" aria-label="Go to page @(pageNumber)">@(pageNumber)</a>
                                            }
                                        </li>
                                    }
                                    else
                                    {
                                        <li><span class="section-pagination-ellipsis" aria-hidden="true">...</span></li>
                                    }
                                }
                            </ol>

                            <span class="section-pagination-status">Page @searchPage of @totalPages</span>

                            @if (searchPage < totalPages)
                            {
                                <a class="section-pagination-link section-pagination-link-nav" href="@BuildPageUrl(searchPage + 1)" rel="next" aria-label="Go to next page">Next</a>
                            }
                            else
                            {
                                <span class="section-pagination-link section-pagination-link-nav is-disabled" aria-disabled="true">Next</span>
                            }
                        </nav>
                    }
                </section>
            }
            else
            {
                <p class="meta">No articles matched "@searchTerm".</p>
            }
        }
    </section>
}
