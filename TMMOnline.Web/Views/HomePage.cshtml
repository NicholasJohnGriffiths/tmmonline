                            <img src="@featuredImageUrl" alt="@featuredArticle.Name" loading="lazy" />
                        </a>
                    }
                    else
                    {
                        <div class="featured-story-placeholder" aria-hidden="true">No Image</div>
                    }
                    <span class="story-label">Lead story</span>
                    <h2><a href="@ResolveContentUrl(featuredArticle)">@featuredArticle.Name</a></h2>
                    @if (featuredDate.HasValue)
                    {
                        <p class="story-date">@featuredDate.Value.ToString("dddd, dd MMMM yyyy")</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(featuredLead))
                    {
                        <p>@featuredLead</p>
                    }
                </article>
